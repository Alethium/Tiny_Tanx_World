code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform vec4 blink_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
instance uniform float blink_intensity : hint_range(0.0, 1.0) = 0.0;
uniform sampler2D Noise2;
instance uniform float destroy_amount : hint_range(0.0, 1.0) = 1.0;



void fragment() {
	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(TEXTURE, UV);
	float n_out8p4 = n_out8p0.a;


// ColorParameter:13
	vec4 n_out13p0 = blink_color;


// FloatParameter:12
	float n_out12p0 = blink_intensity;


// Mix:14
	vec3 n_out14p0 = mix(vec3(n_out8p0.xyz), vec3(n_out13p0.xyz), vec3(n_out12p0));


	vec4 n_out11p0;
// Texture2D:11
	n_out11p0 = texture(Noise2, UV);


// FloatParameter:5
	float n_out5p0 = destroy_amount;


// FloatConstant:6
	float n_out6p0 = 0.000000;


// FloatConstant:7
	float n_out7p0 = 1.000000;


	vec3 n_out4p0;
// If:4
	float n_in4p2 = 0.00001;
	vec3 n_in4p3 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out11p0.x - n_out5p0) < n_in4p2)
	{
		n_out4p0 = n_in4p3;
	}
	else if(n_out11p0.x < n_out5p0)
	{
		n_out4p0 = vec3(n_out7p0);
	}
	else
	{
		n_out4p0 = vec3(n_out6p0);
	}


// Mix:9
	float n_in9p0 = 0.00000;
	float n_out9p0 = mix(n_in9p0, n_out4p0.x, n_out8p4);


// Output:0
	COLOR.rgb = n_out14p0;
	COLOR.a = n_out9p0;


}
"
